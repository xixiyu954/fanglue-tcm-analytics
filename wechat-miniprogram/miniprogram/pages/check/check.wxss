.mode-tabs {
  display: flex;
  background: #eaf0ea;
  border-radius: 14rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #4f6359;
}

.mode-tab-active {
  background: #ffffff;
  color: #2e7d5b;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.search-input {
  background: #f5f7f4;
  border: 2rpx solid #dbe4dd;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.free-textarea {
  width: 100%;
  min-height: 140rpx;
  background: #f5f7f4;
  border: 2rpx solid #dbe4dd;
  border-radius: 14rpx;
  padding: 18rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.suggest-list {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.heat-bar {
  position: relative;
  height: 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2b6cb0 0%, #9fb3a5 50%, #c05a3c 100%);
  margin: 20rpx 0 10rpx;
}

.heat-dot {
  position: absolute;
  top: -7rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 6rpx solid #1f2a24;
  transform: translateX(-50%);
}

.bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.bar-label {
  width: 72rpx;
  font-size: 25rpx;
  color: #32433a;
}

.bar-track {
  flex: 1;
  height: 16rpx;
  background: #edf2ed;
  border-radius: 999rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.bar-fill {
  height: 100%;
  background: #2e7d5b;
  border-radius: 999rpx;
}

.bar-pct {
  width: 72rpx;
  text-align: right;
  font-size: 23rpx;
  color: #607067;
}

.alert-row {
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  font-size: 25rpx;
}

.alert-high {
  background: #fdeeee;
  border-left: 8rpx solid #c94a3f;
  color: #8f241c;
}

.alert-mid {
  background: #fdf4ea;
  border-left: 8rpx solid #d4843e;
  color: #8c4c12;
}

.sim-card {
  padding: 18rpx;
  background: #f6f8f4;
  border-radius: 14rpx;
  margin-bottom: 14rpx;
}
