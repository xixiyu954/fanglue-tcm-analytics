.cat-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #edf2ed;
}

.cat-name {
  width: 120rpx;
  font-weight: 500;
}

.cat-bar {
  flex: 1;
  height: 16rpx;
  background: #edf2ed;
  border-radius: 999rpx;
  overflow: hidden;
  margin: 0 18rpx;
}

.cat-fill {
  height: 100%;
  border-radius: 999rpx;
}

.cat-right {
  width: 140rpx;
  text-align: right;
  font-size: 24rpx;
  color: #55665d;
}

.confuse-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 18rpx;
  background: #fdf6f5;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}
