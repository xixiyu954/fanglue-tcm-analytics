/* 方略随身 · 草本墨绿视觉体系（与方略 Web 平台一脉相承） */
page {
  background-color: #fbfaf6;
  color: #1f2a24;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
  box-sizing: border-box;
}

.page-wrap {
  padding: 24rpx 28rpx 48rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(46, 125, 91, 0.12);
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 36, 0.04);
}

.card-sage {
  background: linear-gradient(135deg, #2e7d5b 0%, #3a8d74 100%);
  color: #ffffff;
  border: none;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2a24;
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sub-text {
  font-size: 24rpx;
  color: #607067;
}

.pill {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #eef4ee;
  color: #2e7d5b;
  margin-right: 12rpx;
  margin-bottom: 10rpx;
}

.pill-warn {
  background: #fdf2e9;
  color: #b85d19;
}

.pill-danger {
  background: #fdecec;
  color: #b83227;
}

.pill-active {
  background: #2e7d5b;
  color: #ffffff;
}

.btn-primary {
  background: #2e7d5b;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 0;
  text-align: center;
  border: none;
}

.btn-primary::after { border: none; }

.btn-outline {
  background: #ffffff;
  color: #2e7d5b;
  border: 2rpx solid #2e7d5b;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  padding: 16rpx 0;
  text-align: center;
}

.btn-outline::after { border: none; }

.insight-box {
  background: #eef4ee;
  border-left: 8rpx solid #2e7d5b;
  border-radius: 0 14rpx 14rpx 0;
  padding: 20rpx 22rpx;
  margin-top: 18rpx;
  font-size: 25rpx;
  color: #26362e;
}

.disclaimer {
  margin-top: 24rpx;
  padding: 18rpx 22rpx;
  background: #f5f3ec;
  border-radius: 14rpx;
  font-size: 22rpx;
  color: #707a74;
  line-height: 1.5;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.kpi-grid {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.kpi-item {
  flex: 1;
  background: rgba(255, 255, 255, 0.14);
  border-radius: 14rpx;
  padding: 18rpx 12rpx;
  text-align: center;
}

.kpi-val {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
}

.kpi-lbl {
  font-size: 22rpx;
  opacity: 0.88;
  margin-top: 6rpx;
}
